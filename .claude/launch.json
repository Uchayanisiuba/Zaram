{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zaram-site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "site",
        "-l",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "zaram-frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd frontend && set ZARAM_API_SECRET=dev-secret && npx vite --port 5173 --strictPort"
      ],
      "port": 5173
    },
    {
      "name": "zaram-documents",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        ".preview",
        "-l",
        "4322"
      ],
      "port": 4322
    },
    {
      "name": "zaram-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd backend && set ZARAM_API_SECRET=dev-secret && venv\\Scripts\\python.exe main.py"
      ],
      "port": 8420
    }
  ]
}
