#!/usr/bin/env sh
# ZCode - the Spine from a terminal.
#
# Finds the bundled interpreter, changes to backend/, runs -m cli.
# Put this folder on PATH and `zcode recall "..."` works anywhere.
set -e
here="$(cd "$(dirname "$0")/backend" && pwd)"
py="$here/venv/bin/python"
[ -x "$py" ] || py="$here/venv/Scripts/python.exe"
[ -x "$py" ] || py="$(command -v python3 || command -v python)"
cd "$here"
exec "$py" -m cli "$@"
